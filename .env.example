# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SCHOOL_ID: Target campus identifier for single-school OnePlace deployment.
VITE_SCHOOL_ID="oakridge-high"

# VITE_SCHOOL_NAME: Display name of the campus.
VITE_SCHOOL_NAME="Oakridge High School"

# VITE_SCHOOL_TIMEZONE: IANA timezone used when creating and displaying campus events.
VITE_SCHOOL_TIMEZONE="America/Los_Angeles"
