# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SCHOOL_ID: Target campus identifier for single-school OnePlace deployment.
VITE_SCHOOL_ID="oakridge-high"

# VITE_SCHOOL_NAME: Display name of the campus.
VITE_SCHOOL_NAME="Oakridge High School"

# VITE_SCHOOL_TIMEZONE: IANA timezone used when creating and displaying campus events.
VITE_SCHOOL_TIMEZONE="America/Los_Angeles"

# VITE_FIREBASE_VAPID_KEY: Web Push certificate public key (from Firebase Console -> Cloud Messaging).
# Optional; required only to enable opt-in browser push notifications via FCM.
VITE_FIREBASE_VAPID_KEY=""

# VITE_SCHOOL_DOMAIN_MAP: Optional JSON map of hostname -> schoolId for multi-school deployments.
# Example: '{"lincoln.oneplace.app":"lincoln-high","oakridge.oneplace.app":"oakridge-high"}'
VITE_SCHOOL_DOMAIN_MAP=""

# VITE_ALLOWED_QUERY_SCHOOLS: Optional comma-separated allowlist of school IDs permitted via ?school=<id> preview parameter.
VITE_ALLOWED_QUERY_SCHOOLS=""
